#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Color codes for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit security checks..."

# Check for potentially sensitive files (excluding package.json and package-lock.json)
SENSITIVE_FILES=$(git diff --cached --name-only | grep -E '\.(env|txt|key|pem|p12|pfx)$' || true)
if [ -n "$SENSITIVE_FILES" ]; then
  echo "${YELLOW}⚠️  WARNING: You're committing files that might contain secrets:${NC}"
  echo "$SENSITIVE_FILES"
  echo ""
  echo "These files should typically not be committed!"
  echo "If running in CI/automation, this check will be skipped."
  echo ""
  
  # Only prompt if in interactive terminal
  if [ -t 0 ]; then
    printf "Are you sure you want to continue? (y/N) "
    read -r response
    case "$response" in
      [yY][eE][sS]|[yY]) 
        echo "Continuing..."
        ;;
      *)
        echo "Commit cancelled."
        exit 1
        ;;
    esac
  else
    echo "Non-interactive mode detected, skipping prompt..."
  fi
fi

# Check for API keys and secrets in staged changes
SECRET_PATTERNS='(api[_-]?key|secret|password|token).*[:=]\s*["\047][a-zA-Z0-9_-]{20,}|AIza[a-zA-Z0-9_-]{35}|sk-[a-zA-Z0-9]{20,}'
if git diff --cached | grep -iE "$SECRET_PATTERNS" > /dev/null; then
  echo "${RED}🚨 DANGER: Potential API key or secret detected in staged changes!${NC}"
  echo ""
  echo "Found potential secrets in:"
  git diff --cached --name-only
  echo ""
  echo "Please remove secrets before committing."
  echo "Use environment variables instead: process.env.YOUR_SECRET"
  echo ""
  exit 1
fi

# Check for common credential files
CREDENTIAL_FILES=$(git diff --cached --name-only | grep -E '(credentials|secrets|apikeys|api_keys)\.txt$|\.key$|\.pem$' || true)
if [ -n "$CREDENTIAL_FILES" ]; then
  echo "${RED}🚨 DANGER: Credential files detected:${NC}"
  echo "$CREDENTIAL_FILES"
  echo ""
  echo "These files should never be committed!"
  exit 1
fi

echo "✅ Security checks passed!"

# Run lint-staged
npx lint-staged
