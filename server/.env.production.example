# Production Environment Configuration for PeerBond Orchestration System

# Application
NODE_ENV=production
PORT=3001
INSTANCE_ID=api-prod-01

# Database
DATABASE_URL=postgresql://peerbond:CHANGE_ME@postgres:5432/peerbond

# Security
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://yourdomain.com

# AI Services
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Redis Cache
REDIS_URL=redis://redis:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Monitoring & Telemetry
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
PROMETHEUS_PORT=9464

# Grafana (for monitoring stack)
GRAFANA_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Database Password (for Docker Compose)
DB_PASSWORD=CHANGE_ME_SECURE_DB_PASSWORD

# SSL/TLS (if using HTTPS)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# Email/Notifications (optional)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your-smtp-password

# Crisis Intervention (optional webhook)
CRISIS_WEBHOOK_URL=https://your-crisis-management-system.com/webhook

# Backup Configuration
BACKUP_S3_BUCKET=peerbond-backups
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Session Configuration
SESSION_TIMEOUT_MS=86400000  # 24 hours
MAX_SESSIONS=10000

# Performance Tuning
MAX_CONNECTIONS=20
QUERY_TIMEOUT=30000

# Feature Flags
ENABLE_TELEMETRY=true
ENABLE_CRISIS_ALERTS=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true