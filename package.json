{
  "name": "peerbond",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "tsc && vite build",
    "build:server": "cd server && npm run build",
    "preview": "vite preview",
    "lint": "npm run lint:frontend && npm run lint:server",
    "lint:frontend": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:server": "cd server && npm run lint",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:server",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:server": "cd server && tsc --noEmit",
    "test": "cd server && npm test",
    "start": "npm run start:server",
    "start:server": "cd server && npm start",
    "db:migrate": "cd server && npm run migrate",
    "db:seed": "cd server && npm run seed",
    "db:studio": "cd server && npx prisma studio",
    "db:reset": "cd server && npx prisma migrate reset",
    "clean": "rm -rf dist node_modules server/dist server/node_modules",
    "clean:db": "rm -rf server/prisma/dev.db*",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^4.35.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^0.279.0",
    "nanoid": "^5.0.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.15.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.8.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@types/uuid": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "axios": "^1.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.29",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
