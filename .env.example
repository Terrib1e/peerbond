# PeerBond Environment Configuration
# ⚠️ SECURITY WARNING: This is a template file!
# Copy this file to .env and fill in your ACTUAL values
# NEVER commit .env files with real secrets!

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Add your actual API keys and secrets to .env
# 3. Verify .env is gitignored: git check-ignore .env

# Google Gemini API Configuration (REQUIRED for Maya AI)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative key name (either works):
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API Configuration (optional, for additional AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peerbond
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://user:password@localhost:5432/peerbond

# JWT Secret (generate with: openssl rand -base64 32)
# IMPORTANT: Use a strong random secret in production!
JWT_SECRET=your-jwt-secret-here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# AI Agent System Configuration
# Set to 'true' to enable the new tool-based agent system
USE_TOOL_SYSTEM=true

# Logging Configuration
LOG_LEVEL=info

# Session Configuration
SESSION_TIMEOUT=1800000
MAX_SESSIONS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@peerbond.com

# Third-party Services (optional)
SENTRY_DSN=your-sentry-dsn-here
STRIPE_API_KEY=your-stripe-api-key-here
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Security Configuration
SECURE_COOKIES=false
TRUST_PROXY=false

# Feature Flags
ENABLE_VOICE_NOTES=true
ENABLE_VIDEO_CALLS=false
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true

# Crisis Support Configuration
CRISIS_HOTLINE_NUMBER=988
CRISIS_TEXT_NUMBER=741741
EMERGENCY_CONTACT_EMAIL=crisis@peerbond.com