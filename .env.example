# PeerBond Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peerbond
DB_USER=your_db_member
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Agent System Configuration
# Set to 'true' to enable the new tool-based agent system
USE_TOOL_SYSTEM=true

# Logging Configuration
LOG_LEVEL=info

# Session Configuration
SESSION_TIMEOUT=1800000
MAX_SESSIONS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@peerbond.com

# Third-party Services (optional)
SENTRY_DSN=
STRIPE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Security Configuration
CORS_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
TRUST_PROXY=false

# Feature Flags
ENABLE_VOICE_NOTES=true
ENABLE_VIDEO_CALLS=false
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true

# Crisis Support Configuration
CRISIS_HOTLINE_NUMBER=988
CRISIS_TEXT_NUMBER=741741
EMERGENCY_CONTACT_EMAIL=crisis@peerbond.com